# 基础例子1 · 发下面触发词自测（语法说明见「插件文档.md」）
#
# 发送          测什么
# 测试1         临时定义 + 拼接 + 发消息
# 测试2         全局定义
# 测试3         发详细消息 + 群号/发言人
# 测试4         嵌套如果 + 反之
# 测试4-1       四则运算 + {变量} 插值
# 测试5         url 发图 + 消息ID/头像
# 测试5-1       本地图 数据文件/cover.png
# 测试5-2       语音 url + 本地
# 测试5-3       视频 url + 本地
# 测试5-4       文件 url + 本地
# 测试6         取艾特 + For循环（消息里带「测试6」即可，可同时艾特人）
# 测试7         match + 取括号（含：测试7 / 测试7-1 / 测试7-2 / 测试7-3）
# 测试8         发送回执 + 等待 / 延时
# 测试9         [时间] 及冒号扩展
# 测试9-1       转时间（时间戳→文本，可自定义模板）
# 测试10        转数字()
# 测试11        撤回自己发的消息（群/私均可）
# 测试11-1      仅群聊：撤回发言人消息（需管理权限）
# 测试12        发Markdown：发送方式短例
# 测试12-1～10  标题/样式/链接/图片/有序/无序/嵌套/引用/分割线/换多行
# 测试12-11     参数指令：蓝字填入输入框
# 测试12-12     回车指令：蓝字直接发送（建议私聊；群不支持）
# 测试12-13     跳转链接
# 测试12-14     回调按钮（底部 keyboard；点一下无需打字）
# 测试12-15     多行回调按钮 + 网络图 + 蓝/白/红
# 测试12-16     点后文案 visited_label（点前/点后不一样）
# 测试12-17     权限：所有人 / 仅管理者 / 仅发言人
# 测试12-18     跳转钮 + 指令钮（多类型）
# 测试18        签到（写/读 积分，演示持久化）
# 测试19        查询（读 积分 / 签到日）
# 测试20        访问 GET（赞助名单：原始 JSON + For循环取值）
# 测试20-1      访问 POST JSON（原始 + 取值）
# 测试20-2      访问 POST 表单（原始 + 取值）

[风格标准]:text


# -------------------- 测试1：临时定义 + 拼接 + 发消息 --------------------
# 发送：测试1

[如果]([文本消息] == `测试1`){
    [临时定义] 招呼 = "你好呀～"
    招呼 += "\n嘻嘻嘻"
    发消息(招呼)
    [结束]
}


# -------------------- 测试2：全局定义 --------------------
# 发送：测试2
# 全局定义写在 [如果] 外面，同文件多条规则共享

[全局定义] 全局招呼 = `你是谁？`

[如果]([文本消息] == "测试2"){
    发消息(全局招呼)
    [结束]
}


# -------------------- 测试3：发详细消息 + 群号/发言人 --------------------
# 发送：测试3
# 发详细消息("群"|"私", openid, 内容)

[如果]([文本消息] == "测试3"){
    发详细消息("群", [群号], "这是指定群发送的例子")
    发详细消息("私", [发言人], 全局招呼)
    [结束]
}


# -------------------- 测试4：嵌套如果 + 反之 --------------------
# 发送：测试4
# 无引号 111 → 数字；有引号 "111" → 字符串

[如果]([文本消息] == "测试4"){
    [临时定义] a = 111
    [临时定义] b = 222
    [如果](a > b){
        发消息("成功")
    }[反之]{
        发消息("失败")
    }
}


# -------------------- 测试4-1：四则运算 + 插值 --------------------
# 发送：测试4-1
# * / 优先于 + -；可用 ()；字符串里用 {变量名}

[如果]([文本消息] == "测试4-1"){
    [临时定义] 加 = 1 + 2
    [临时定义] 减 = 10 - 3
    [临时定义] 乘 = 4 * 5
    [临时定义] 除 = 20 / 4
    [临时定义] 连算 = 1 + 2 * 3
    [临时定义] 括号 = (1 + 2) * 3
    [临时定义] 综合 = (10 - 4) / 2 + 3 * 2

    [临时定义] 出 = "算式演示："
    出 += "\n1+2 = {加}"
    出 += "\n10-3 = {减}"
    出 += "\n4*5 = {乘}"
    出 += "\n20/4 = {除}"
    出 += "\n1+2*3 = {连算}"
    出 += "\n(1+2)*3 = {括号}"
    出 += "\n(10-4)/2+3*2 = {综合}"
    发消息(出)
    [结束]
}


# -------------------- 测试5：url 发图 + 消息ID/头像 --------------------
# 发送：测试5
# 头像：https://q.qlogo.cn/qqapp/{AppID}/{发言人}/{尺寸}

[如果]([文本消息] == "测试5"){
    [临时定义] 出 = `[图片,url:https://q.qlogo.cn/qqapp/{AppID}/{发言人}/100]`
    出 += `[图片,url:https://q.qlogo.cn/qqapp/{AppID}/{发言人}/640]`
    出 += `\n本条消息ID={消息ID}`
    出 += `\n发言人openid={发言人}`
    出 += `\n上为两张发言人头像（100 / 640）`
    发消息(出)
    [结束]
}


# -------------------- 测试5-1：本地图 --------------------
# 发送：测试5-1
# 路径相对插件根目录，常用 数据文件/xxx

[如果]([文本消息] == "测试5-1"){
    [临时定义] 出 = `[图片,本地:数据文件/cover.png]`
    出 += `\n本地相对路径发图`
    发消息(出)
    [结束]
}


# -------------------- 测试5-2：语音 url + 本地 --------------------
# 发送：测试5-2
# 语音单发，不挂文字

[如果]([文本消息] == "测试5-2"){
    发消息(`[语音,url:https://xn--mk-ub3cl61ae1v.xn--c5w857b.xn--fiqs8s/mkbot/%E5%B0%86%E5%86%9B.mp3]`)
    发消息(`[语音,本地:数据文件/将军.mp3]`)
    [结束]
}


# -------------------- 测试5-3：视频 url + 本地 --------------------
# 发送：测试5-3
# 视频单发，不挂文字

[如果]([文本消息] == "测试5-3"){
    发消息(`[视频,url:https://api.yujn.cn/api/zzxjj.php?type=video]`)
    发消息(`[视频,本地:数据文件/70.mp4]`)
    [结束]
}


# -------------------- 测试5-4：文件 url + 本地 --------------------
# 发送：测试5-4
# 文件单发，不挂文字；末尾 ,显示名 自定义卡片名（URL 也会生效）

[如果]([文本消息] == "测试5-4"){
    发消息(`[文件,url:https://xn--mk-ub3cl61ae1v.xn--c5w857b.xn--fiqs8s/mkbot/%E8%B5%9E%E5%8A%A9.json,赞助说明.json]`)
    发消息(`[文件,本地:数据文件/404.html,自定义说明.html]`)
    [结束]
}


# -------------------- 测试6：取艾特 + For循环 --------------------
# 发送：消息里带「测试6」（可同时艾特人）
# {取艾特:i} 取 openid；i++ 自增；[跳过]/[中断] 只作用于本层循环

[如果]([文本消息].match(/测试6/)){
    [临时定义] i = 0
    [临时定义] n = [取艾特数]
    [临时定义] 出 = `艾特数={n}\n列表：`
    [For循环](i ＜ n){
        出 += `\n[{i}]={取艾特:i}`
        i++
    }
    发消息(出)
    [结束]
}


# -------------------- 测试7：match + 取括号 --------------------
# 发送示例：
#   测试7你好        → 包含匹配，取出「你好」
#   测试7-1 甲 乙    → 两个捕获组
#   测试7-2你好      → ^ 锚定开头
#   测试7-3你好      → ^…$ 整段匹配
# 更具体的写法写在前面

[如果]([文本消息].match(/^测试7-3(.*)$/)){
    发消息("7-3括号={取括号:1}")
    [结束]
}

[如果]([文本消息].match(/^测试7-2(.*)/)){
    发消息("7-2括号={取括号:1}")
    [结束]
}

[如果]([文本消息].match(/测试7-1 (.*) (.*)/)){
    发消息("第一={取括号:1}\n第二={取括号:2}\n全文={取括号}")
    [结束]
}

[如果]([文本消息].match(/测试7(.*)/)){
    发消息("括号内容={取括号:1}")
    [结束]
}


# -------------------- 测试8：发送回执 + 等待 --------------------
# 发送：测试8
# [临时定义] x = [等待] 发消息(...) → 回执；语句版发消息并行，[等待] 冲刷；[等待:毫秒] 延时

[如果]([文本消息] == "测试8"){
    [临时定义] 出 = "回执测试"
    [临时定义] 回执 = [等待] 发消息(出)
    [等待] 发消息("成功={回执[成功]} id={回执[消息id]} 条数={回执[条数]}")

    发消息("并行A")
    发消息("并行B")
    [等待]
    [等待] 发消息("pending已结束")

    [等待] 发消息("直接等待发送")
    [等待:2000]
    [等待] 发消息("延时2秒后继续")
    [结束]
}


# -------------------- 测试9：[时间] --------------------
# 发送：测试9
# 默认 YYYY-MM-DD HH:mm:ss（本地时区，到秒）；可用冒号取年/月/日/时/分/秒/时间戳

[如果]([文本消息] == "测试9"){
    [临时定义] 出 = "默认={时间}"
    出 += "\n毫秒={时间:时间戳毫秒}"
    出 += "\n秒戳={时间:时间戳秒}"
    出 += "\n年={时间:年} 月={时间:月} 日={时间:日}"
    出 += "\n时={时间:时} 分={时间:分} 秒={时间:秒}"
    发消息(出)
    [结束]
}


# -------------------- 测试9-1：转时间（时间戳→文本） --------------------
# 发送：测试9-1
# 默认格式同 [时间]；第三参可写模板（YYYY/MM/DD/HH/mm/ss）

[如果]([文本消息] == "测试9-1"){
    [临时定义] 毫秒 = [时间:时间戳毫秒]
    [临时定义] 出 = [转时间:时间戳毫秒,毫秒]
    出 += "\n"
    出 += [转时间:时间戳毫秒,毫秒,"YYYY年MM月DD日，HH时mm分ss秒"]
    发消息(出)
    [结束]
}


# -------------------- 测试10：转数字() --------------------
# 发送：测试10
# 去空白后转数字；括号内算式强制按数字算；失败则原样返回字符串

[如果]([文本消息] == "测试10"){
    [临时定义] a = 转数字(1 + 2 * 3)
    [临时定义] b = 转数字(" 08 ")
    [临时定义] c = 转数字("10" * "2")
    [临时定义] d = 转数字("abc")
    [临时定义] 出 = "算式={a}"
    出 += "\n去空格={b}"
    出 += "\n乘积={c}"
    出 += "\n失败原样={d}"
    出 += "\n插值={转数字(1+2)}"
    发消息(出)
    [结束]
}


# -------------------- 测试11：撤回自己发的消息 --------------------
# 发送：测试11（群聊 / 私聊均可）
# 发一条 → 等5秒 → 撤回 → 文本告知结果

[如果]([文本消息] == "测试11"){
    [临时定义] 回执 = [等待] 发消息("这条将在5秒后撤回")
    [等待:5000]
    [临时定义] 撤 = [等待] 撤回(回执[消息id])
    发消息("已尝试撤回自己消息：成功={撤[成功]} 错误={撤[错误]}")
    [结束]
}


# -------------------- 测试11-1：撤回发言人消息（仅群） --------------------
# 发送：测试11-1
# 需机器人有群管理权限；私聊会提示不可用

[如果]([文本消息] == "测试11-1"){
    [如果]([群号] == 0){
        发消息("测试11-1 仅群聊可用")
        [结束]
    }
    [临时定义] 撤 = [等待] 撤回([消息ID])
    发消息("撤回发言人消息：成功={撤[成功]} 错误={撤[错误]}")
    [结束]
}


# -------------------- 测试12：发Markdown 发送方式短例 --------------------
# 发送：测试12

[如果]([文本消息] == "测试12"){
    [临时定义] md = "# 标题 
## 简介很开心 
内容[🔗腾讯](https://www.qq.com)"
    发Markdown(md)
    [结束]
}


