打开：[官方文档](https://bot.q.qq.com/wiki/)"
    发Markdown(md)
    [结束]
}


# -------------------- 测试12-14：回调按钮（底部，无需打字） --------------------
# 发送：测试12-14
# 点按钮触发 INTERACTION，button_data 注入为文本消息；自定义 keyboard 需官方开通

[如果]([文本消息] == "测试12-14"){
    [临时定义] md = "# 回调按钮
点下面按钮即可，无需在输入框发消息"
    发Markdown(md, 键盘(按钮行(回调钮("cb14", "点我有反应", "测试12-14回执"))))
    [结束]
}

[如果]([文本消息] == "测试12-14回执"){
    发消息("已收到回调按钮（INTERACTION），你没有手动发消息")
    [结束]
}


# -------------------- 测试12-15：多行回调按钮（蓝/白/红） --------------------
# 发送：测试12-15
# 样式仅支持 1蓝 / 2白 / 3红；每行按钮数相同，宽度才会齐

[如果]([文本消息] == "测试12-15"){
    [临时定义] md = "# 按钮样式
仅 `1`蓝 / `2`白 / `3`红
![panel #208px #320px](https://resource5-1255303497.cos.ap-guangzhou.myqcloud.com/abcmouse_word_watch/markdown/building.png)"
    [临时定义] 行1 = 按钮行(
        回调钮("r1a", "蓝", "测试12-15:蓝", 1),
        回调钮("r1b", "白", "测试12-15:白", 2),
        回调钮("r1c", "红", "测试12-15:红", 3)
    )
    [临时定义] 行2 = 按钮行(
        回调钮("r2a", "蓝", "测试12-15:蓝2", 1),
        回调钮("r2b", "白", "测试12-15:白2", 2),
        回调钮("r2c", "红", "测试12-15:红2", 3)
    )
    [临时定义] 行3 = 按钮行(
        回调钮("r3a", "蓝", "测试12-15:蓝3", 1),
        回调钮("r3b", "白", "测试12-15:白3", 2),
        回调钮("r3c", "红", "测试12-15:红3", 3)
    )
    发Markdown(md, 键盘(行1, 行2, 行3))
    [结束]
}

[如果]([文本消息].match(/^测试12-15:/)){
    发消息("点了回调按钮：" + [文本消息])
    [结束]
}


# -------------------- 测试12-16：点后文案 visited_label --------------------
# 发送：测试12-16
# 点前「点我签到」→ 点后变「已签到✓」（客户端展示；仍会回调）

[如果]([文本消息] == "测试12-16"){
    [临时定义] md = "# 点后文案
点一下看按钮文字是否变成「已签到✓」"
    发Markdown(
        md,
        键盘(按钮行(
            回调钮("v1", "点我签到", "测试12-16:签到", 1, "已签到✓"),
            回调钮("v2", "点我领奖", "测试12-16:领奖", 2, "已领奖"),
            回调钮("v3", "点我确认", "测试12-16:确认", 3, "已确认")
        ))
    )
    [结束]
}

[如果]([文本消息].match(/^测试12-16:/)){
    发消息("收到回调：" + [文本消息] + "（按钮应已变成点后文案）")
    [结束]
}


# -------------------- 测试12-17：权限（谁能点） --------------------
# 发送：测试12-17
# 「仅管理」≠「仅呼出者」：
# - 官方群聊对 permission.type=1 经常不拦点击
# - 插件在回调时按「点击者」身份缓存验权（群主/管理最近在群里发过言才会被记住）
# - 与谁发出测试12-17无关：普通人呼出后，非管理点「仅管理」也会被拒

[如果]([文本消息] == "测试12-17"){
    [临时定义] 身份 = [获取群身份]
    [临时定义] md = "# 按钮权限
- 所有人：谁都能点
- 仅管理：验的是点击者是不是群主/管理（不是验谁呼出的）
- 仅我：只有当前发言人
你当前身份：" + 身份
    发Markdown(
        md,
        键盘(
            按钮行(
                回调钮("p2", "所有人可点", "测试12-17:所有人", 1, "已点·所有人", 2),
                回调钮("p1", "仅管理可点", "测试12-17:管理", 2, "已点·管理", 1)
            ),
            按钮行(
                回调钮("p0", "仅我可点", "测试12-17:仅我", 3, "已点·仅我", 0, [发言人])
            )
        )
    )
    [结束]
}

[如果]([文本消息].match(/^测试12-17:/)){
    发消息("权限回调通过：" + [文本消息] + "\n点击人=" + [发言人] + "\n身份=" + [获取群身份])
    [结束]
}


# -------------------- 测试12-18：跳转钮 + 指令钮 --------------------
# 发送：测试12-18
# 跳转钮 type=0；指令钮 type=2（填入/回车建议私聊测）

[如果]([文本消息] == "测试12-18"){
    [临时定义] md = "# 多类型按钮
- 跳转：打开链接
- 指令填入：写入输入框（不自动发）
- 指令回车：直接发送（建议私聊）"
    发Markdown(
        md,
        键盘(
            按钮行(
                跳转钮("l1", "打开文档", "https://bot.q.qq.com/wiki/", 1, "已打开")
            ),
            按钮行(
                指令钮("c1", "填入测试1", "测试1", 2, "已填入", 0, 0),
                指令钮("c2", "直接发测试1", "测试1", 3, "已发送", 1, 0)
            )
        )
    )
    [结束]
}

# -------------------- 测试18：签到 --------------------
# 发送：测试18
# 用 读/写 记每人积分与今日是否已签；写文件 追加一行日志

[如果]([文本消息] == "测试18"){
    [临时定义] 今日 = [时间:YYYY-MM-DD]
    [临时定义] 上次 = 读("演示/签到日.json", [发言人], "")
    [如果](上次 == 今日){
        [临时定义] 分 = 读("演示/积分.json", [发言人], 0)
        发消息("今天已经签过啦～\n当前积分：" + 分)
        [结束]
    }
    [临时定义] 分 = 转数字(读("演示/积分.json", [发言人], 0)) + 1
    写("演示/积分.json", [发言人], 分)
    写("演示/签到日.json", [发言人], 今日)
    [临时定义] 旧日志 = 读文件("演示/签到日志.txt")
    写文件("演示/签到日志.txt", 旧日志 + 今日 + " 积分→" + 分 + "\n")
    发消息("签到成功！\n日期：" + 今日 + "\n当前积分：" + 分)
    [结束]
}

# -------------------- 测试19：查询 --------------------
# 发送：测试19

[如果]([文本消息] == "测试19"){
    [临时定义] 分 = 读("演示/积分.json", [发言人], 0)
    [临时定义] 日 = 读("演示/签到日.json", [发言人], "还没签过")
    [临时定义] 日志 = 读文件("演示/签到日志.txt")
    [如果](日志 == ""){
        发消息("查询结果\n积分：" + 分 + "\n最近签到：" + 日 + "\n日志：（暂无）")
        [结束]
    }
    发消息("查询结果\n积分：" + 分 + "\n最近签到：" + 日 + "\n日志：\n" + 日志)
    [结束]
}

# -------------------- 测试20：访问 GET --------------------
# 发送：测试20
# 赞助名单：先发原始 JSON，再 For循环逐条取值

[如果]([文本消息] == "测试20"){
    [临时定义] r = 访问("GET", "https://xn--mk-ub3cl61ae1v.xn--c5w857b.xn--fiqs8s/mkbot/赞助.json")
    [等待] 发消息("访问 GET 原始\n成功=" + r[成功] + " 状态码=" + r[状态码] + "\n" + r[内容])
    [临时定义] 名单 = 取JSON(r[内容])
    [临时定义] n = 取长度(名单)
    [临时定义] i = 0
    [临时定义] 出 = "取值 共" + n + "人："
    [For循环](i ＜ n){
        [临时定义] 项 = 名单[i]
        出 += "\n[" + i + "] " + 项[name] + " / " + 项[qq] + " / " + 项[amount]
        i++
    }
    [等待] 发消息(出)
    [结束]
}

