# 基础例子3 — 生命周期事件（QQ 官方机器人）
# 与例子1/2分开：本文件专放进群、好友、通知开关、成员进退、进群申请等
#
# 说明：
# - [事件] = 中文简短名（进群 / 退群 / 加好友 / 进群申请 …）
# - 事件驱动时 [文本消息] 也等于该简短名，下面两种写法等价
# - 退群 / 删好友 / 关主动消息 / 关群通知：无法发消息，发消息只会打日志

[风格标准]:text

# -------------------- 进群（机器人被拉进群）--------------------
[如果]([事件] == "进群"){
    发消息("你好，我是机器人，已进群～")
    [结束]
}

# -------------------- 退群（机器人被移出）--------------------
# 无法发消息；若写了发消息，只打日志
[如果]([事件] == "退群"){
    # 发消息("我退群了")  ← 无效，仅日志
    [结束]
}

# -------------------- 加好友 --------------------
[如果]([事件] == "加好友"){
    发消息("你好，已添加好友～")
    [结束]
}

# -------------------- 删好友 --------------------
# 无法发消息
[如果]([事件] == "删好友"){
    [结束]
}

# -------------------- 开 / 关主动消息（资料卡）--------------------
# 实际上报多为 INTERACTION type=18 + authorize_data.scope=c2c_push
#（switch=true 为开；无 switch / false 为关），不是旧的 C2C_MSG_* 事件名
[如果]([事件] == "开主动消息"){
    发消息("已开启主动消息，后续可主动联系你")
    [结束]
}

[如果]([事件] == "关主动消息"){
    # 无法发消息（关闭后主动消息会被拒）
    [结束]
}

# -------------------- 开 / 关群通知（群管理资料页）--------------------
[如果]([事件] == "开群通知"){
    发消息("本群已开启机器人通知")
    [结束]
}

[如果]([事件] == "关群通知"){
    # 无法发消息
    [结束]
}

# -------------------- 成员进退群 --------------------
# 也可用 [文本消息] == "成员进群"（事件驱动时二者相同）
[如果]([文本消息] == "成员进群"){
    发消息("欢迎新成员～ openid=" + [发言人])
    [结束]
}

[如果]([事件] == "成员退群"){
    发消息("有成员离开了 openid=" + [发言人])
    [结束]
}

# -------------------- 进群申请（GROUP_JOIN_REQUEST）--------------------
# 需：机器人为群管理员；群开启「需审核 / 回答问题」等入群方式
# 输出：Markdown（头像、问题、答案等）+ 四按钮
#   同意 / 拒绝 / 拉黑（拒绝并入群黑名单）/ 忽略（仅本地提示，不调审批接口）
# 按钮权限=1「仅管理」：非管理点了会被插件拒（群聊客户端可能拦不住灰显）
# 申请ID 很长，先写本地；按钮 data 只带 openid，回调再读出

[如果]([事件] == "进群申请"){
    [临时定义] 申 = 取入群申请()
    [临时定义] 存键 = "入群申请/" + [群号] + ".json"
    写(存键, 申[openid], 申[申请ID])
    [临时定义] 头像 = "https://q.qlogo.cn/qqapp/" + [AppID] + "/" + 申[openid] + "/100"
    [临时定义] 风险 = 申[风险提示]
    [如果](风险 == ""){
        风险 = "无"
    }
    [临时定义] md = "# 入群申请
![头像 #100px #100px](" + 头像 + ")
- **昵称**：" + 申[昵称] + "
- **openid**：`" + 申[openid] + "`
- **来源**：" + 申[来源] + "
- **时间**：" + 申[申请时间] + "
- **验证方式**：" + 申[验证方式] + "
- **问题**：" + 申[问题] + "
- **答案**：" + 申[答案] + "
- **风险**：" + 风险
    [如果](申[邀请人] != ""){
        md += "
- **邀请人**：`" + 申[邀请人] + "`"
    }
    [如果](申[问答明细] != ""){
        md += "

### 问答明细
" + 申[问答明细]
    }
    [临时定义] 行1 = 按钮行(
        回调钮("ja", "同意", "进群申请:同意:" + 申[openid], 1, "已同意", 1),
        回调钮("jr", "拒绝", "进群申请:拒绝:" + 申[openid], 3, "已拒绝", 1)
    )
    [临时定义] 行2 = 按钮行(
        回调钮("jb", "拉黑", "进群申请:拉黑:" + 申[openid], 3, "已拉黑", 1),
        回调钮("ji", "忽略", "进群申请:忽略:" + 申[openid], 2, "已忽略", 1)
    )
    发Markdown(md, 键盘(行1, 行2))
    [结束]
}

# 管理员点按钮后的回调（权限=仅管理；插件回调入口会再验身份缓存）
# 四个按钮各自走到下面分支，在分支里调官方审批接口：
#   同意 → 审批入群申请(openid, "同意", 申请ID)
#   拒绝 → 审批入群申请(openid, "拒绝", 申请ID)
#   拉黑 → 审批入群申请(openid, "拉黑", 申请ID)  （拒绝并 add_to_member_blacklist）
#   忽略 → 不调接口，只回提示
[如果]([文本消息].match(/^进群申请:(同意|拒绝|拉黑|忽略):(.+)$/)){
    [临时定义] 动作 = [取括号:1]
    [临时定义] 对象 = [取括号:2]
    [临时定义] 存键 = "入群申请/" + [群号] + ".json"
    [临时定义] 申请ID = 读(存键, 对象, "")
    [临时定义] 回 = 0

    [如果](动作 == "同意"){
        回 = 审批入群申请(对象, "同意", 申请ID)
    }
    [如果](动作 == "拒绝"){
        回 = 审批入群申请(对象, "拒绝", 申请ID, "管理员拒绝")
    }
    [如果](动作 == "拉黑"){
        回 = 审批入群申请(对象, "拉黑", 申请ID, "管理员拉黑")
    }
    [如果](动作 == "忽略"){
        发消息("已忽略申请（未调用审批接口）openid=" + 对象)
        [结束]
    }

    [临时定义] 出 = "入群审批：" + 动作
    出 += "\n成功=" + 回[成功]
    出 += "\n对象=" + 对象
    [如果](回[成功] == false){
        出 += "\n错误=" + 回[错误]
    }
    [如果](回[成功] == true){
        写(存键, 对象, "")
    }
    发消息(出)
    [结束]
}
