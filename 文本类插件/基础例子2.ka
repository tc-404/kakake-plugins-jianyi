# 基础例子2 — 群聊类能力（QQ 官方机器人）
# 与「基础例子1」分开：本文件专放群身份 / 群管理相关示例
#
# 触发词一览：
# 测试13  获取群身份（发言人 + 机器人自己）
# 测试14  获取群基本信息（info，可能需白名单）
# 测试15  获取机器人群内状态（bot_state，可能需白名单）
# 测试16  查询群禁言状态
# 测试17  设置群成员禁言（格式：测试17@某人；须管理员/群主；禁 60 秒）

[风格标准]:text

# -------------------- 测试13：获取群身份 --------------------
# 发送：测试13（仅群聊）
# [获取群身份] 默认发言人；[获取群身份:自己] 调 bot_state（可能需白名单）
# 取值：member 普通 / admin 管理 / owner 群主；取不到为 0

[如果]([文本消息] == "测试13"){
    [如果]([群号] == 0){
        发消息("测试13仅群聊可用")
        [结束]
    }
    [临时定义] 出 = "发言人身份=" + [获取群身份]
    出 += "\n机器人身份=" + [获取群身份:自己]
    出 += "\n(member普通 admin管理 owner群主；取不到为0)"
    发消息(出)
    [结束]
}

# -------------------- 测试14：获取群基本信息 --------------------
# 发送：测试14（仅群聊；GET …/info，白名单失败则成功=false）

[如果]([文本消息] == "测试14"){
    [如果]([群号] == 0){
        发消息("测试14仅群聊可用")
        [结束]
    }
    [临时定义] 信息 = [获取群信息]
    [临时定义] 出 = "成功=" + 信息[成功]
    出 += "\n群名=" + 信息[群名]
    出 += "\n简介=" + 信息[简介]
    出 += "\n分类=" + 信息[分类]
    出 += "\n人数=" + 信息[人数]
    出 += "\n标签=" + 信息[标签]
    出 += "\n错误=" + 信息[错误]
    发消息(出)
    [结束]
}

# -------------------- 测试15：获取机器人群内状态 --------------------
# 发送：测试15（仅群聊；GET …/bot_state，白名单失败则成功=false）

[如果]([文本消息] == "测试15"){
    [如果]([群号] == 0){
        发消息("测试15仅群聊可用")
        [结束]
    }
    [临时定义] 态 = [获取机器人群状态]
    [临时定义] 出 = "成功=" + 态[成功]
    出 += "\nopenid=" + 态[openid]
    出 += "\n入群时间=" + 态[入群时间]
    出 += "\n主动消息=" + 态[主动消息]
    出 += "\n收消息设置=" + 态[收消息设置]
    出 += "\n身份=" + 态[身份]
    出 += "\n错误=" + 态[错误]
    发消息(出)
    [结束]
}

# -------------------- 测试16：查询群禁言状态 --------------------
# 发送：测试16（仅群聊；GET …/restrict_chat_setting）

[如果]([文本消息] == "测试16"){
    [如果]([群号] == 0){
        发消息("测试16仅群聊可用")
        [结束]
    }
    [临时定义] 禁 = [查询群禁言]
    [临时定义] 出 = "成功=" + 禁[成功]
    出 += "\n全员模式=" + 禁[全员模式]
    出 += "\n禁言人数=" + 禁[禁言人数]
    出 += "\n明细=" + 禁[明细]
    出 += "\n错误=" + 禁[错误]
    发消息(出)
    [结束]
}

# -------------------- 测试17：设置群成员禁言 --------------------
# 发送格式：测试17@要禁言的人
# （仅群；你须是管理员/群主；机器人须是群管理员；禁言 60 秒）
# 若群设置为「仅@机器人可收」，需同时@机器人，例如：@机器人 测试17@某人

[如果]([文本消息].match(/^测试17/)){
    [如果]([群号] == 0){
        发消息("测试17仅群聊可用")
        [结束]
    }
    [临时定义] 身 = [获取群身份]
    [如果](身 != "admin"){
        [如果](身 != "owner"){
            发消息("无权：需要管理员或群主（当前身份=" + 身 + "）")
            [结束]
        }
    }
    [如果]([取艾特数] < 1){
        发消息("格式：测试17@要禁言的人")
        [结束]
    }
    [临时定义] 回 = 设置群禁言([取艾特], 60)
    [临时定义] 出 = "设置群禁言：成功=" + 回[成功]
    出 += "\n操作=" + 回[操作]
    出 += "\n成员=" + 回[成员]
    出 += "\n到期=" + 回[到期]
    出 += "\n错误=" + 回[错误]
    发消息(出)
    [结束]
}
